{
  "name": "@haeckmec/grounded-chat",
  "version": "0.0.7",
  "description": "Grounded chat SDK: an LLM chat that only states figures and facts the host app's own tools returned.",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haeckmec/grounded-chat.git",
    "directory": "packages/grounded-chat"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=20.19"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapters/gemini": {
      "types": "./dist/adapters/gemini/index.d.ts",
      "import": "./dist/adapters/gemini/index.js",
      "default": "./dist/adapters/gemini/index.js"
    },
    "./adapters/dummy": {
      "types": "./dist/adapters/dummy/index.d.ts",
      "import": "./dist/adapters/dummy/index.js",
      "default": "./dist/adapters/dummy/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "default": "./dist/http/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "import": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./admin-react": {
      "types": "./dist/admin-react/index.d.ts",
      "import": "./dist/admin-react/index.js",
      "default": "./dist/admin-react/index.js"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "import": "./dist/eval/index.js",
      "default": "./dist/eval/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@haeckmec/eslint-config": "*",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "undici": "^7.30.0",
    "vitest": "^4.1.9"
  }
}
